#!/usr/bin/env bash
set -Eeuo pipefail
request="${SSH_ORIGINAL_COMMAND:-}"
pattern='^vps-ops (status|health|brain-logs|proxy-logs|caddy-check|caddy-reload|brain-restart|brain-backup)$'
if [[ "$request" =~ $pattern ]]; then
  exec /usr/bin/sudo -n /usr/local/sbin/vps-ops-run "${BASH_REMATCH[1]}"
fi
echo 'Acces refuse : commande non autorisee.' >&2
exit 64
