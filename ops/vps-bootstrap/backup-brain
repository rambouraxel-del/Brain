#!/usr/bin/env bash
# Consistent local SQLite backup. An off-VPS copy is still essential.
set -Eeuo pipefail
umask 077
SRC=/var/lib/brain/data/brain.sqlite3
DEST=/var/backups/brain
[[ -f "$SRC" ]] || exit 0
install -d -m 0700 "$DEST"
OUT="$DEST/brain-$(date -u +%Y%m%dT%H%M%SZ).sqlite3"
python3 - "$SRC" "$OUT" <<'PY'
import sqlite3, sys
with sqlite3.connect(f'file:{sys.argv[1]}?mode=ro', uri=True) as source:
    with sqlite3.connect(sys.argv[2]) as destination:
        source.backup(destination)
PY
chmod 0600 "$OUT"
find "$DEST" -maxdepth 1 -type f -name 'brain-*.sqlite3' -mtime +6 -delete
echo "Sauvegarde locale créée : $OUT"
